# Microsoft Foundry endpoint. Copy to .env and fill in.
# Never commit .env. Never log prompts, completions, tokens or credentials.
#
# Chat uses the Foundry Responses API via the Day 3 Model Gateway.
# Prefer AICO_FOUNDRY_API_KEY for this lab. DefaultAzureCredential remains supported.

AICO_FOUNDRY_ENDPOINT=https://YOUR-RESOURCE.services.ai.azure.com
AICO_FOUNDRY_API_KEY=
AICO_FOUNDRY_API_VERSION=2024-02-01
AZURE_EMBEDDING_DIMENSIONS=1536
